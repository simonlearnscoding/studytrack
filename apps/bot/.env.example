# The bot's Discord token (Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=xxx

# The Convex deployment to report to (same value as VITE_CONVEX_URL in apps/web)
CONVEX_URL=https://your-deployment.convex.cloud

# Must match BOT_SHARED_SECRET set on the Convex deployment
BOT_SHARED_SECRET=change-me

# Optional: the guild to watch (for logging only)
GUILD_ID=
