# Convex deployment URL (written automatically by `pnpm dev:db`, or copy from the dashboard)
VITE_CONVEX_URL=https://your-deployment.convex.cloud

# Clerk
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Dev only: show the time-travel bar. The Convex deployment must also be a dev
# deployment (DEV_AUTH_BYPASS=1); leave this unset for production builds.
# VITE_DEV_CLOCK=1
