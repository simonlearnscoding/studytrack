{
  "name": "studytrack",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @studytrack/backend --filter @studytrack/web dev",
    "dev:web": "pnpm --filter @studytrack/web dev",
    "dev:db": "pnpm --filter @studytrack/backend dev",
    "dev:bot": "pnpm --filter @studytrack/bot dev",
    "build": "pnpm --filter @studytrack/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "routes:generate": "pnpm --filter @studytrack/web routes:generate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.71.1"
  }
}
